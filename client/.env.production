# Production build settings
GENERATE_SOURCEMAP=false
INLINE_RUNTIME_CHUNK=false

# Production server
REACT_APP_SERVER_URL=https://solshot.onrender.com

# Solana network
REACT_APP_SOLANA_NETWORK=mainnet-beta

# On-chain program IDs — DB CHAIN-N01: do NOT commit IDs here.
# Set the mainnet values in the Vercel project Environment Variables UI so we
# can't accidentally ship devnet IDs to a mainnet build (and vice-versa). The
# variables the client reads are:
#   REACT_APP_ESCROW_PROGRAM_ID       (v1 escrow, only if v1 is still deployed)
#   REACT_APP_ESCROW_V2_PROGRAM_ID    (v2 escrow — required)
#   REACT_APP_SOLANA_RPC              (mainnet RPC endpoint — required to avoid public-tier rate limits)
# REACT_APP_SHOT_TOKEN_MINT is intentionally absent: V3 pivots SHOT off-chain.

# Privy embedded wallet (public App ID — safe to commit)
REACT_APP_PRIVY_APP_ID=cmorbf1nk00z10cidg6jitsgm
